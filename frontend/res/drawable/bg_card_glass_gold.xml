<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de Monedero Créditos Halcón: Gradiente Oro TecNM con brillo metálico -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="135"
        android:startColor="#33D4AF37"
        android:centerColor="#1A1B396A"
        android:endColor="#400A0E17"
        android:type="linear" />
    <stroke
        android:width="1.5dp"
        android:color="#B3D4AF37" />
</shape>

